name: Build Transcriber (Windows .exe)

on:
  workflow_dispatch:
    inputs:
      torch_variant:
        description: "PyTorch: cuda = jalan di GPU NVIDIA & otomatis CPU bila tak ada GPU (besar). cpu = lebih kecil, hanya CPU."
        type: choice
        default: cuda
        options: [cuda, cpu]
      whisper_model:
        description: "Model Whisper yang ikut dikemas (none = tidak dikemas, diunduh saat pertama dipakai)"
        type: choice
        default: small
        options: [none, base, small, medium, turbo]
      bundle_demucs:
        description: "Kemas bobot Demucs (htdemucs, ~80 MB) agar pisah vokal langsung jalan offline"
        type: boolean
        default: true
  push:
    tags: ["v*"]

jobs:
  build:
    runs-on: windows-latest
    timeout-minutes: 120
    defaults:
      run:
        shell: pwsh
    env:
      VARIANT: ${{ inputs.torch_variant || 'cuda' }}
      WHISPER_MODEL: ${{ inputs.whisper_model || 'small' }}
      BUNDLE_DEMUCS: ${{ (github.event_name == 'workflow_dispatch' && inputs.bundle_demucs == false) && 'false' || 'true' }}
      PYTHONUTF8: "1"

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip
          cache-dependency-path: requirements.txt

      - name: Pasang PyTorch (cuda atau cpu)
        run: |
          python -m pip install --upgrade pip
          # setuptools<81: setup.py openai-whisper masih memakai pkg_resources
          python -m pip install "setuptools<81" wheel
          $index = if ($env:VARIANT -eq "cpu") { "https://download.pytorch.org/whl/cpu" } else { "https://download.pytorch.org/whl/cu121" }
          python -m pip install torch==2.5.1 torchaudio==2.5.1 --index-url $index

      - name: Pasang dependensi aplikasi
        run: |
          python -m pip install --no-build-isolation openai-whisper
          python -m pip install -r requirements.txt pyinstaller
          python -m pip list

      - name: Unduh ffmpeg
        run: |
          $ProgressPreference = "SilentlyContinue"
          Invoke-WebRequest "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl.zip" -OutFile ffmpeg.zip
          Expand-Archive ffmpeg.zip -DestinationPath ffmpeg_tmp
          New-Item -ItemType Directory -Path ffmpeg | Out-Null
          $exe = Get-ChildItem ffmpeg_tmp -Recurse -Filter ffmpeg.exe | Select-Object -First 1
          Copy-Item $exe.FullName ffmpeg\
          Copy-Item (Join-Path $exe.DirectoryName "ffprobe.exe") ffmpeg\
          Remove-Item ffmpeg.zip, ffmpeg_tmp -Recurse -Force
          Get-ChildItem ffmpeg

      - name: Unduh model Whisper
        if: env.WHISPER_MODEL != 'none'
        run: |
          python -c "import whisper; whisper.load_model('$env:WHISPER_MODEL', device='cpu', download_root='models')"
          Get-ChildItem models

      - name: Unduh bobot Demucs
        if: env.BUNDLE_DEMUCS == 'true'
        run: |
          $env:TORCH_HOME = Join-Path $PWD "torch_home"
          python -c "from demucs.pretrained import get_model; get_model('htdemucs')"
          Get-ChildItem torch_home -Recurse -File

      - name: Build dengan PyInstaller
        run: pyinstaller --noconfirm Transcriber.spec

      - name: Uji hasil build (selftest)
        run: |
          $report = Join-Path $PWD "selftest.txt"
          $p = Start-Process -FilePath "dist\Transcriber\Transcriber.exe" -ArgumentList "--selftest", $report -Wait -PassThru
          if (Test-Path $report) { Get-Content $report } else { Write-Host "Laporan selftest tidak dibuat (aplikasi kemungkinan crash saat start)." }
          if ($p.ExitCode -ne 0) { throw "Selftest gagal (exit code $($p.ExitCode))" }

      - name: Hapus berkas uji dari paket
        if: always()
        run: |
          Remove-Item "dist\Transcriber\.write_test" -ErrorAction SilentlyContinue
          Remove-Item "dist\Transcriber\selftest.txt" -ErrorAction SilentlyContinue
          Remove-Item "dist\Transcriber\Hasil Transkrip" -Recurse -Force -ErrorAction SilentlyContinue

      - uses: actions/upload-artifact@v4
        with:
          name: Transcriber-win64-${{ env.VARIANT }}
          path: dist/Transcriber
          compression-level: 6
          retention-days: 14
